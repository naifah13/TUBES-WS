@prefix ex: <http://www.example.org/showroom#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Impor ke named graph urn:vroom:relasi-kendaraan dalam dataset /showroom.
# Label model berasal dari daftar kata kunci pencarian Vroom.
# Relasi merek showroom diambil dari ex:merek pada showroomSumut.ttl.

# Merek
ex:MerekAION a ex:MerekKendaraan ; rdfs:label "AION" .
